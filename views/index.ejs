<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo App</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #140a26;
            --glass: rgba(255, 255, 255, 0.07);
            --glass-border: rgba(255, 255, 255, 0.14);
            --text: #f6f1ff;
            --muted: #a99ccc;
            --violet: #8b5cf6;
            --pink: #ff4fa3;
            --grad: linear-gradient(135deg, #8b5cf6, #ff4fa3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Outfit", "Segoe UI", sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px;
            position: relative;
            overflow-x: hidden;
        }

        /* soft glowing blobs behind the card */
        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            filter: blur(110px);
            opacity: 0.55;
            z-index: 0;
            animation: drift 14s ease-in-out infinite alternate;
        }

        body::before {
            background: var(--violet);
            top: -120px;
            left: -100px;
        }

        body::after {
            background: var(--pink);
            bottom: -140px;
            right: -100px;
            animation-delay: -7s;
        }

        @keyframes drift {
            to { transform: translate(60px, 40px) scale(1.15); }
        }

        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 520px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            padding: 36px 32px;
            border-radius: 28px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
        }

        h1 {
            text-align: center;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 28px;
            background: var(--grad);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        form {
            display: flex;
            gap: 10px;
            margin-bottom: 28px;
        }

        input[type="text"] {
            flex: 1;
            min-width: 0;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            color: var(--text);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        input[type="text"]::placeholder {
            color: var(--muted);
        }

        input[type="text"]:focus {
            border-color: var(--pink);
            box-shadow: 0 0 0 4px rgba(255, 79, 163, 0.2);
        }

        button {
            padding: 14px 22px;
            border: none;
            background: var(--grad);
            color: #fff;
            border-radius: 14px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            box-shadow: 0 8px 22px rgba(255, 79, 163, 0.35);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(255, 79, 163, 0.5);
        }

        button:active {
            transform: translateY(0);
        }

        button:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }

        ul {
            list-style: none;
        }

        li {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            padding: 16px 18px;
            margin-bottom: 12px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            transition: transform 0.25s, background 0.25s, border-color 0.25s;
        }

        li:hover {
            transform: translateX(6px);
            background: rgba(255, 255, 255, 0.11);
            border-color: rgba(255, 79, 163, 0.5);
        }

        .task-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 38px;
            height: 38px;
            margin-right: 14px;
            border-radius: 12px;
            background: var(--grad);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .task-text {
            word-break: break-word;
            line-height: 1.4;
        }

        .empty {
            text-align: center;
            color: var(--muted);
            padding: 28px 12px;
            border: 1px dashed var(--glass-border);
            border-radius: 16px;
        }

        .footer {
            position: relative;
            z-index: 1;
            margin-top: 26px;
            color: var(--muted);
            font-size: 0.9rem;
            text-align: center;
        }

        @media (prefers-reduced-motion: reduce) {
            body::before,
            body::after {
                animation: none;
            }
            li, button {
                transition: none;
            }
        }

        @media (max-width: 420px) {
            .container { padding: 28px 20px; }
            form { flex-direction: column; }
        }
    </style>
</head>
<body>

    <div class="container">

        <h1>📝 My Todo List</h1>

        <form action="/add" method="POST">
            <input
                type="text"
                name="task"
                placeholder="What needs doing?"
                required>
            <button type="submit">➕ Add</button>
        </form>

        <% if (todos.length === 0) { %>
            <div class="empty">
                No tasks yet. Add your first one above 🚀
            </div>
        <% } %>

        <ul>
            <% todos.forEach(function(todo, index) { %>
                <li>
                    <span class="task-number">#<%= index + 1 %></span>
                    <span class="task-text"><%= todo %></span>
                </li>
            <% }) %>
        </ul>

    </div>

    <div class="footer">
        Made with a lot of you
    </div>

</body>
</html>
